# ── HEMMELIGHETER ─────────────────────────────────────────────────────────────
# Kopier denne filen til .env og fyll inn verdiene.
# .env skal ALDRI committes til git.

# Anthropic API-nøkkel: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Supabase: Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# API-nøkkel som beskytter alle /api/-endepunkter
# Generer med: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# Tillatt frontend-domene for CORS (endre til produksjonsdomenet ved deploy)
FRONTEND_ORIGIN=http://localhost:8000

# Sett til false i produksjon
MOCK_MODE=false
